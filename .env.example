# DesignPilot AI Environment Configuration
# Copy this file to .env and populate required API keys for server-side web search integrations.

# Google Gemini API Key
# Get API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Tavily Web Search API Key
# Get free API key at: https://tavily.com
TAVILY_API_KEY=

# Optional Envato Market API Personal Access Token
ENVATO_API_TOKEN=

# Development Provider Switch (true = DemoInspirationProvider, false = LiveSearchProvider)
USE_DEMO_INSPIRATION=false

# Optional Server Port Configuration
PORT=8080


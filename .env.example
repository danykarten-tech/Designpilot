# DesignPilot AI Environment Configuration
# Copy this file to .env and populate required API tokens for server-side search integrations.

# Envato Market API Personal Access Token
# Create access token at: https://build.envato.com/create-token
ENVATO_API_TOKEN=

# Development Provider Switch (true = DemoInspirationProvider, false = LiveSearchProvider)
USE_DEMO_INSPIRATION=false

# Optional Server Port Configuration
PORT=8080
